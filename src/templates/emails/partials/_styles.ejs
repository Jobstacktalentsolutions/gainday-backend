<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', sans-serif; line-height: 1.6; color: #1a202c; background-color: #eef0fb; }
  .wrapper { width: 100%; background-color: #eef0fb; padding: 32px 16px; }
  .container { max-width: 560px; margin: 0 auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; }

  /* header + banner (shared across every template — see partials/_header.ejs) */
  .header { background-color: #eef0fb; padding: 24px 32px; text-align: left; }
  .logo { height: 28px; width: auto; }
  .banner { background-color: #1817fe; padding: 36px 32px; }
  .banner h1 { margin: 0; color: #ffffff; font-size: 24px; font-weight: 600; }

  .content { padding: 32px; }
  .intro { font-size: 15px; color: #4a5568; margin-bottom: 20px; line-height: 1.6; }
  .divider { height: 1px; background-color: #e2e8f0; margin: 24px 0; }

  /* buttons — color/background also set inline on the <a> itself (belt-and-suspenders).
     Gmail, Outlook.com and several mobile mail apps strip <style> blocks or override
     anchor colors with their own defaults, so the class alone is not reliable. */
  .cta-button { display: inline-block; background-color: #1817fe; color: #ffffff; text-decoration: none; padding: 12px 28px; border-radius: 6px; font-weight: 600; font-size: 14px; margin: 8px 0; }

  .link-section { background-color: #f7fafc; border: 1px solid #e2e8f0; padding: 16px; border-radius: 6px; margin: 20px 0; }
  .link-label { font-size: 11px; color: #718096; text-transform: uppercase; margin-bottom: 8px; font-weight: 600; letter-spacing: 0.5px; }
  .link-text { color: #1817fe; font-size: 13px; word-break: break-all; font-family: monospace; }

  .alert { background-color: #fef3c7; border-left: 4px solid #f59e0b; padding: 16px; margin: 20px 0; border-radius: 4px; }
  .alert-text { color: #92400e; font-size: 14px; }

  .highlight-box { background-color: #f0f4ff; border-left: 4px solid #1817fe; padding: 20px 24px; margin: 24px 0; border-radius: 6px; }
  .highlight-box .kicker { font-size: 11px; font-weight: 700; letter-spacing: 0.5px; color: #1817fe; text-transform: uppercase; margin-bottom: 8px; }
  .highlight-box p { margin: 0; font-size: 14px; line-height: 1.6; color: #3a3a4d; }

  .score-value { font-size: 48px; font-weight: 700; color: #1817fe; margin: 0; }
  .score-label { font-size: 14px; color: #4a5568; margin-top: 8px; }
  .badge { display: inline-block; background-color: #f0f4ff; color: #1817fe; padding: 6px 12px; border-radius: 4px; font-size: 12px; font-weight: 600; margin-bottom: 12px; }
  .metric-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #e2e8f0; font-size: 14px; }
  .metric-row:last-child { border-bottom: none; }
  .metric-name { color: #4a5568; }
  .metric-score { color: #1817fe; font-weight: 600; }
  .card-number { font-size: 36px; font-weight: 700; color: #1817fe; margin: 0; }
  .card-label { font-size: 14px; color: #4a5568; margin: 8px 0 0 0; }
  .card-title { font-size: 16px; font-weight: 600; color: #1817fe; margin-top: 16px; }

  .footer { background-color: #f7fafc; padding: 30px; text-align: center; border-top: 1px solid #e2e8f0; }
  .footer-text { font-size: 12px; color: #718096; margin: 6px 0; }
  .social-icons a { display: inline-block; text-decoration: none; }
</style>
