<div class="footer">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="social-icons-table">
    <tr>
      <td style="padding-right: 20px;">
        <a href="https://x.com/gaindayltd" target="_blank" title="X (Twitter)" style="display: inline-block; text-decoration: none;">
          <img src="<%= appUrl %>/social-icons/twitter.png" width="28" height="28" alt="X (Twitter)" style="display: block; width: 28px; height: 28px; border: 0;" />
        </a>
      </td>
      <td style="padding-right: 20px;">
        <a href="https://www.instagram.com/gaindayltd/" target="_blank" title="Instagram" style="display: inline-block; text-decoration: none;">
          <img src="<%= appUrl %>/social-icons/instagram.png" width="28" height="28" alt="Instagram" style="display: block; width: 28px; height: 28px; border: 0;" />
        </a>
      </td>
      <td>
        <a href="https://linkedin.com/company/gainday" target="_blank" title="LinkedIn" style="display: inline-block; text-decoration: none;">
          <img src="<%= appUrl %>/social-icons/linkedin.png" width="28" height="28" alt="LinkedIn" style="display: block; width: 28px; height: 28px; border: 0;" />
        </a>
      </td>
    </tr>
  </table>
  <div class="footer-meta">
    UK, London.<br />
    &copy; Copyright <%= year %> Gainday.
    <% if (typeof unsubscribeUrl !== 'undefined' && unsubscribeUrl) { %>
      <a href="<%= unsubscribeUrl %>" style="color: #1817fe; text-decoration: none;">Unsubscribe</a>
    <% } else { %>
      <a href="<%= appUrl %>/privacy" style="color: #1817fe; text-decoration: none;">Privacy</a>
    <% } %>
  </div>
</div>
