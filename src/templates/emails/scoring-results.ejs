<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Assessment Results</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', sans-serif; line-height: 1.6; color: #2d3748; background-color: #f7fafc; }
    .wrapper { width: 100%; background-color: #f7fafc; padding: 20px 0; }
    .container { max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; }
    .header { padding: 40px 20px; text-align: center; border-bottom: 1px solid #e2e8f0; }
    .logo { height: 40px; width: auto; margin-bottom: 16px; }
    .header h1 { font-size: 24px; font-weight: 600; color: #1a202c; margin: 0; }
    .badge { display: inline-block; background-color: #f0f4ff; color: #1817fe; padding: 6px 12px; border-radius: 4px; font-size: 12px; font-weight: 600; margin-bottom: 12px; }
    .content { padding: 40px 30px; }
    .intro { font-size: 15px; color: #4a5568; margin-bottom: 24px; line-height: 1.6; }
    .score-card { background-color: #f0f4ff; border-left: 4px solid #1817fe; padding: 24px; margin: 24px 0; border-radius: 6px; text-align: center; }
    .score-value { font-size: 48px; font-weight: 700; color: #1817fe; margin: 0; }
    .score-label { font-size: 14px; color: #4a5568; margin-top: 8px; }
    .metrics { margin: 24px 0; }
    .metric-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #e2e8f0; font-size: 14px; }
    .metric-row:last-child { border-bottom: none; }
    .metric-name { color: #4a5568; }
    .metric-score { color: #1817fe; font-weight: 600; }
    .cta-button { display: inline-block; background-color: #1817fe; color: #ffffff; text-decoration: none; padding: 12px 28px; border-radius: 6px; font-weight: 600; font-size: 14px; margin: 24px 0; }
    .footer { background-color: #f7fafc; padding: 30px; text-align: center; border-top: 1px solid #e2e8f0; }
    .footer-text { font-size: 12px; color: #718096; margin: 6px 0; }
    .social-icons { margin: 20px 0; display: flex; gap: 16px; justify-content: center; }
    .social-icons a { display: inline-block; width: 32px; height: 32px; border-radius: 50%; background-color: #e2e8f0; display: flex; align-items: center; justify-content: center; text-decoration: none; border: 1px solid #e2e8f0; }
    .social-icons a:hover { background-color: #cbd5e0; }
    .divider { height: 1px; background-color: #e2e8f0; margin: 24px 0; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <div class="header">
        <img src="<%= logoUrl %>" alt="Gainday" class="logo" />
        <h1>Your Assessment Results</h1>
      </div>

      <div class="content">
        <div style="text-align: center; margin-bottom: 24px;">
          <span class="badge"><%= jobTitle %></span>
        </div>

        <p class="intro">Congratulations! Your work simulation has been evaluated. Here's your performance summary:</p>

        <div class="score-card">
          <div class="score-value"><%= overallScore %></div>
          <div class="score-label">Overall Score (out of 100)</div>
        </div>

        <% if (categoryScores) { %>
        <div class="metrics">
          <% if (categoryScores.problemSolving !== undefined) { %>
            <div class="metric-row"><span class="metric-name">Problem Solving</span><span class="metric-score"><%= categoryScores.problemSolving %></span></div>
          <% } %>
          <% if (categoryScores.execution !== undefined) { %>
            <div class="metric-row"><span class="metric-name">Execution</span><span class="metric-score"><%= categoryScores.execution %></span></div>
          <% } %>
          <% if (categoryScores.writtenCommunication !== undefined) { %>
            <div class="metric-row"><span class="metric-name">Written Communication</span><span class="metric-score"><%= categoryScores.writtenCommunication %></span></div>
          <% } %>
          <% if (categoryScores.domainAwareness !== undefined) { %>
            <div class="metric-row"><span class="metric-name">Domain Awareness</span><span class="metric-score"><%= categoryScores.domainAwareness %></span></div>
          <% } %>
          <% if (categoryScores.prioritization !== undefined) { %>
            <div class="metric-row"><span class="metric-name">Prioritization</span><span class="metric-score"><%= categoryScores.prioritization %></span></div>
          <% } %>
        </div>
        <% } %>

        <center>
          <a href="<%= dashboardUrl %>" class="cta-button">View Full Results</a>
        </center>

        <div class="divider"></div>

        <p class="intro" style="font-size: 13px;">Your results will be reviewed by the hiring team. If you're a strong match, they may reach out with next steps. Check your email for updates.</p>
      </div>

      <div class="footer">
        <p class="footer-text"><strong>Gainday</strong> • Hire With Confidence</p>
        <p class="footer-text">© <%= year %> Gainday, Inc. All rights reserved.</p>
        <div class="social-icons">
          <a href="https://twitter.com/gainday" title="Twitter">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1817fe" stroke-width="2"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2s9 5 20 5a9.5 9.5 0 0 0-9-5.5c4.75 2.25 9-1 9-5.5v-1c.75-.5 1.43-1.12 2-1.855z"/></svg>
          </a>
          <a href="https://linkedin.com/company/gainday" title="LinkedIn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1817fe" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
        </div>
        <p class="footer-text" style="margin-top: 16px; font-size: 11px;"><a href="<%= frontendUrl %>/help" style="color: #1817fe; text-decoration: none;">Help</a> • <a href="<%= frontendUrl %>/privacy" style="color: #1817fe; text-decoration: none;">Privacy</a> • <a href="<%= frontendUrl %>/terms" style="color: #1817fe; text-decoration: none;">Terms</a></p>
      </div>
    </div>
  </div>
</body>
</html>
