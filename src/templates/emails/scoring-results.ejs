<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Work Simulation Results</title>
  <%- include('partials/_styles') %>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <%- include('partials/_header', { bannerTitle: 'Your simulation results' }) %>

      <%
        // Labels for the grading categories the platform scores today (see CATEGORY_KEYS in
        // capability-passport.util.ts). Keep in sync with CATEGORY_ORDER on the frontend.
        var CATEGORY_LABELS = {
          problemSolving: 'Problem solving',
          judgmentExecution: 'Judgment & execution',
          writtenCommunication: 'Written communication',
          commercialDomainAwareness: 'Commercial & domain awareness'
        };

        var categories = [];
        if (typeof categoryScores !== 'undefined' && categoryScores) {
          Object.keys(CATEGORY_LABELS).forEach(function (key) {
            if (categoryScores[key] === undefined || categoryScores[key] === null) return;
            var rawVal = categoryScores[key];
            var numVal = typeof rawVal === 'number' ? rawVal : rawVal.score;
            categories.push({
              label: CATEGORY_LABELS[key],
              score: Math.min(100, Math.max(0, Math.round(numVal)))
            });
          });
        }

        var hasTaskBreakdown = typeof taskBreakdown !== 'undefined' && taskBreakdown && taskBreakdown.length > 0;
        var standoutParagraphs = [];
        if (!hasTaskBreakdown && typeof whatStoodOut !== 'undefined' && whatStoodOut) {
          standoutParagraphs = typeof whatStoodOut === 'string'
            ? whatStoodOut.split(/(?<=\.)\s+(?=You\b)|\n+/g).filter(Boolean)
            : [whatStoodOut];
        }
        var hasStandout = hasTaskBreakdown || standoutParagraphs.length > 0;
      %>

      <div class="content">
        <p class="intro" style="margin-bottom: 24px; font-size: 15px; color: #3a3a4d; line-height: 1.6;">
          You completed the work simulation for <strong><%= typeof jobTitle !== 'undefined' ? jobTitle : 'your role' %></strong><% if (typeof companyName !== 'undefined' && companyName) { %> at <strong><%= companyName %></strong><% } %>. Here is how you did.
        </p>

        <!-- Circular Overall Score -->
        <div class="score-circle-wrap">
          <div class="score-circle">
            <div class="score-circle-cell">
              <span class="score-circle-number"><%= typeof overallScore !== 'undefined' && overallScore !== null ? overallScore : '—' %></span>
            </div>
          </div>
        </div>

        <div class="score-subtitle">
          Overall score out of 100
        </div>

        <!-- Category Progress Bars -->
        <% if (categories.length > 0) { %>
        <div style="margin: 28px 0 20px 0;">
          <% categories.forEach(function(item) { %>
            <div class="skill-group">
              <div class="skill-label"><%= item.label %></div>
              <table role="presentation" class="skill-table" cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                  <td class="skill-track-wrap">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="skill-track">
                      <tr>
                        <td width="<%= item.score %>%" class="skill-fill"></td>
                        <td width="<%= 100 - item.score %>%" style="height: 8px;"></td>
                      </tr>
                    </table>
                  </td>
                  <td class="skill-value">
                    <span><%= item.score %>%</span>
                  </td>
                </tr>
              </table>
            </div>
          <% }); %>
        </div>
        <% } %>

        <!-- WHAT STOOD OUT Box (only when the grading produced feedback) -->
        <% if (hasStandout) { %>
        <div class="standout-box">
          <div class="standout-title">WHAT STOOD OUT</div>
          <% if (hasTaskBreakdown) { %>
            <% taskBreakdown.forEach(function(item, idx) {
                 var rawTitle = (item.title || 'Task').trim();
                 var displayTitle = /^Task\s+\d+/i.test(rawTitle)
                   ? rawTitle
                   : ('Task ' + (idx + 1) + ': ' + rawTitle);
            %>
              <div style="<%= idx > 0 ? 'margin-top: 14px; padding-top: 12px; border-top: 1px solid #e4e4f0;' : '' %>">
                <div style="font-size: 13px; font-weight: 700; color: #1a1a2e; margin-bottom: 4px;">
                  <%= displayTitle %>
                </div>
                <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #3a3a4d;">
                  <%= (item.summary || '').trim() %>
                </p>
              </div>
            <% }); %>
          <% } else { %>
            <% standoutParagraphs.forEach(function(para, idx) { %>
              <p style="margin: 0 0 <%= idx === standoutParagraphs.length - 1 ? 0 : 12 %>px 0; font-size: 13px; line-height: 1.6; color: #3a3a4d;">
                <%= para.trim() %>
              </p>
            <% }); %>
          <% } %>
        </div>
        <% } %>

        <!-- Validity Note Box -->
        <div class="validity-box">
          <p>Your capability score is valid for 18 months. This score travels with you to every future Gainday application.</p>
        </div>

        <!-- Action Button -->
        <div class="cta-wrap">
          <%
            var primaryUrl = typeof passportUrl !== 'undefined' && passportUrl
              ? passportUrl
              : (typeof dashboardUrl !== 'undefined' && dashboardUrl ? dashboardUrl : (appUrl + '/candidate/passport'));
          %>
          <a href="<%= primaryUrl %>" class="cta-button" target="_blank" style="background-color:#1817fe; color:#ffffff !important; text-decoration:none; padding:14px 32px; border-radius:10px; font-weight:600; font-size:15px; display:inline-block;">
            View your full Capability Passport
          </a>
          <% if (typeof resultUrl !== 'undefined' && resultUrl && resultUrl !== primaryUrl) { %>
            <div style="margin-top: 14px;">
              <a href="<%= resultUrl %>" target="_blank" style="color: #1817fe; font-size: 14px; font-weight: 500; text-decoration: underline;">
                View simulation breakdown &amp; submission details
              </a>
            </div>
          <% } %>
        </div>
      </div>

      <%- include('partials/_footer', { year: year, appUrl: appUrl }) %>
    </div>
  </div>
</body>
</html>
