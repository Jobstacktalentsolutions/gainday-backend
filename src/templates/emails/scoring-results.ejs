<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Assessment Results</title>
  <%- include('partials/_styles') %>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <%- include('partials/_header', { bannerTitle: 'Your Assessment Results' }) %>

      <div class="content">
        <div style="text-align: center; margin-bottom: 24px;">
          <span class="badge"><%= jobTitle %></span>
        </div>

        <p class="intro">Congratulations! Your work simulation has been evaluated. Here's your performance summary:</p>

        <div class="highlight-box" style="text-align: center; border-left: none; border-top: 4px solid #1817fe;">
          <div class="score-value"><%= overallScore %></div>
          <div class="score-label">Overall Score (out of 100)</div>
        </div>

        <% if (categoryScores) { %>
        <div style="margin: 24px 0;">
          <% if (categoryScores.problemSolving !== undefined) { %>
            <div class="metric-row"><span class="metric-name">Problem Solving</span><span class="metric-score"><%= categoryScores.problemSolving %>/10</span></div>
          <% } %>
          <% if (categoryScores.judgmentExecution !== undefined) { %>
            <div class="metric-row"><span class="metric-name">Judgment / Execution</span><span class="metric-score"><%= categoryScores.judgmentExecution %>/10</span></div>
          <% } %>
          <% if (categoryScores.writtenCommunication !== undefined) { %>
            <div class="metric-row"><span class="metric-name">Written Communication</span><span class="metric-score"><%= categoryScores.writtenCommunication %>/10</span></div>
          <% } %>
          <% if (categoryScores.commercialDomainAwareness !== undefined) { %>
            <div class="metric-row"><span class="metric-name">Commercial / Domain Awareness</span><span class="metric-score"><%= categoryScores.commercialDomainAwareness %>/10</span></div>
          <% } %>
        </div>
        <% } %>

        <% if (taskBreakdown && taskBreakdown.length) { %>
        <div class="divider"></div>
        <p class="intro" style="margin-bottom: 12px;"><strong>Task by task</strong></p>
        <% taskBreakdown.forEach(function(task) { %>
          <div style="margin-bottom: 16px;">
            <p style="font-size: 14px; font-weight: 600; color: #1a202c; margin-bottom: 4px;"><%= task.title %></p>
            <p style="font-size: 14px; color: #4a5568; margin: 0;"><%= task.summary %></p>
          </div>
        <% }); %>
        <% } %>

        <center>
          <a href="<%= dashboardUrl %>" class="cta-button" style="background-color:#1817fe; color:#ffffff !important; text-decoration:none; padding:12px 28px; border-radius:6px; font-weight:600; font-size:14px; display:inline-block;">View Full Results</a>
        </center>

        <div class="divider"></div>

        <p class="intro" style="font-size: 13px;">Your results will be reviewed by the hiring team. If you're a strong match, they may reach out with next steps. Check your email for updates.</p>
      </div>

      <%- include('partials/_footer', { year: year, appUrl: appUrl }) %>
    </div>
  </div>
</body>
</html>
