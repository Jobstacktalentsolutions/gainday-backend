<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome to Gainday</title>
  <%- include('partials/_styles') %>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <%- include('partials/_header', { bannerTitle: 'Welcome to Gainday' }) %>

      <div class="content">
        <p class="intro">Your account is ready to go. Log in to start creating job assessments and finding the right candidates.</p>

        <center>
          <a href="<%= appUrl %>/employer/dashboard" class="cta-button" style="background-color:#1817fe; color:#ffffff !important; text-decoration:none; padding:12px 28px; border-radius:6px; font-weight:600; font-size:14px; display:inline-block;">Access Your Dashboard</a>
        </center>

        <div class="divider"></div>

        <h3 style="font-size: 16px; color: #1a202c; margin-bottom: 16px;">What you can do:</h3>
        <div style="margin: 24px 0;">
          <div style="display:flex; gap:12px; margin:12px 0; font-size:14px; color:#4a5568;"><span style="color:#1817fe; font-weight:700;">&#10003;</span><span>Create work simulations and assessments</span></div>
          <div style="display:flex; gap:12px; margin:12px 0; font-size:14px; color:#4a5568;"><span style="color:#1817fe; font-weight:700;">&#10003;</span><span>Invite candidates and track submissions</span></div>
          <div style="display:flex; gap:12px; margin:12px 0; font-size:14px; color:#4a5568;"><span style="color:#1817fe; font-weight:700;">&#10003;</span><span>Review AI-powered scoring and analytics</span></div>
          <div style="display:flex; gap:12px; margin:12px 0; font-size:14px; color:#4a5568;"><span style="color:#1817fe; font-weight:700;">&#10003;</span><span>Compare candidates with detailed reports</span></div>
        </div>

        <div class="divider"></div>

        <p class="intro" style="font-size: 13px;">Need help? Check our <a href="<%= appUrl %>/help" style="color:#1817fe !important; text-decoration:none;">help center</a> or <a href="mailto:support@gainday.com" style="color:#1817fe !important; text-decoration:none;">contact support</a>.</p>
      </div>

      <%- include('partials/_footer', { year: year, appUrl: appUrl }) %>
    </div>
  </div>
</body>
</html>
