<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify Your Email</title>
  <%- include('partials/_styles') %>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <%- include('partials/_header', { bannerTitle: 'Verify Your Email' }) %>

      <div class="content">
        <p class="intro">Thank you for signing up for Gainday! To complete your registration, please verify your email address by clicking the button below.</p>

        <center>
          <a href="<%= verifyLink %>" class="cta-button" style="background-color:#1817fe; color:#ffffff !important; text-decoration:none; padding:12px 28px; border-radius:6px; font-weight:600; font-size:14px; display:inline-block;">Verify Email Address</a>
        </center>

        <p class="intro">If the button doesn't work, copy and paste this link in your browser:</p>

        <div class="link-section">
          <div class="link-label">Verification Link</div>
          <div class="link-text"><%= verifyLink %></div>
        </div>

        <p class="intro" style="font-size: 13px; color: #718096;">This link expires in 24 hours for your security.</p>

        <div class="divider"></div>

        <p class="intro" style="font-size: 13px;">Didn't create a Gainday account? If you received this email by mistake, you can safely ignore it.</p>
      </div>

      <%- include('partials/_footer', { year: year, appUrl: appUrl }) %>
    </div>
  </div>
</body>
</html>
