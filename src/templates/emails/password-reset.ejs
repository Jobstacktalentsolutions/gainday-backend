<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset your Gainday password</title>
  <%- include('partials/_styles') %>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <%- include('partials/_header', { bannerTitle: 'Reset your password' }) %>

      <div class="content">
        <p class="intro">
          We received a request to reset your password. Click the button below to create a new password.
        </p>

        <div class="cta-wrap">
          <a href="<%= typeof resetLink !== 'undefined' ? resetLink : '#' %>" class="cta-button" target="_blank" style="background-color:#1817fe; color:#ffffff !important; text-decoration:none; padding:14px 32px; border-radius:10px; font-weight:600; font-size:15px; display:inline-block;">
            Reset Your Password
          </a>
        </div>

        <p class="intro" style="font-size: 14px; margin-top: 24px; margin-bottom: 8px;">
          If the button doesn't work, copy and paste this link in your browser:
        </p>

        <div class="link-section">
          <div class="link-label">Reset Link</div>
          <div class="link-text"><%= typeof resetLink !== 'undefined' ? resetLink : '' %></div>
        </div>

        <div class="alert">
          <div class="alert-text">
            <strong>Expires in <%= typeof expiryHours !== 'undefined' ? expiryHours : 24 %> hours</strong> &mdash; For security, this link is only valid for <%= typeof expiryHours !== 'undefined' ? expiryHours : 24 %> hours.
          </div>
        </div>

        <div class="divider"></div>

        <p class="intro" style="font-size: 13px; color: #6a6a85;">
          Didn't request a password reset? If you believe someone else tried to access your account, <a href="<%= appUrl %>/help" style="color:#1817fe !important; text-decoration:none;">contact support</a> immediately.
        </p>
      </div>

      <%- include('partials/_footer', { year: year, appUrl: appUrl }) %>
    </div>
  </div>
</body>
</html>
