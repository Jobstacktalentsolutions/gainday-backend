<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Alert</title>
  <%- include('partials/_styles') %>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <%- include('partials/_header', { bannerTitle: 'Admin Alert' }) %>

      <div class="content">
        <p class="intro">
          <strong style="color: #b42318; text-transform: uppercase; letter-spacing: 0.5px;"><%= severity %></strong>
          &mdash; <%= title %>
        </p>

        <div class="message-box danger"><%= message %></div>

        <% if (details) { %>
        <div style="margin: 20px 0;">
          <div class="section-label">Reason</div>
          <div class="message-box code"><%= details %></div>
        </div>
        <% } %>

        <div class="divider"></div>

        <p style="font-size: 13px; color: #767592;">
          View and acknowledge this in the admin portal:
          <a href="<%= notificationsUrl %>" style="color: #1817fe; text-decoration: underline;">Notifications</a>
        </p>
      </div>

      <%- include('partials/_footer', { year: year, appUrl: appUrl }) %>
    </div>
  </div>
</body>
</html>
