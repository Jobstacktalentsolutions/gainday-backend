<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Submissions Received</title>
  <%- include('partials/_styles') %>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <%- include('partials/_header', { bannerTitle: 'New Submissions Received' }) %>

      <div class="content">
        <p class="intro">Great news! You've received new applications for your job posting.</p>

        <div class="highlight-box" style="border-left: none; border-top: 4px solid #1817fe;">
          <div class="card-number"><%= candidateCount %></div>
          <div class="card-label">New Submission<%= candidateCount !== 1 ? 's' : '' %></div>
          <div class="card-title"><%= jobTitle %></div>
        </div>

        <center>
          <a href="<%= appUrl %>/employer/jobs" class="cta-button" style="background-color:#1817fe; color:#ffffff !important; text-decoration:none; padding:12px 28px; border-radius:6px; font-weight:600; font-size:14px; display:inline-block;">Review Applications</a>
        </center>

        <div class="divider"></div>

        <p class="intro" style="font-size: 13px;">Log in to your Gainday dashboard to review candidates, compare their scores, and manage next steps.</p>
      </div>

      <%- include('partials/_footer', { year: year, appUrl: appUrl }) %>
    </div>
  </div>
</body>
</html>
