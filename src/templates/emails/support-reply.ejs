<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reply from Gainday support</title>
  <%- include('partials/_styles') %>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <%- include('partials/_header', { bannerTitle: 'Reply from Gainday support' }) %>

      <div class="content">
        <p class="intro">
          Hello <strong><%= recipientName %></strong>,
        </p>

        <p class="intro">
          Thanks for contacting us about <strong><%= topic %></strong>. Here is our reply:
        </p>

        <!-- Admin Response Block -->
        <div class="message-box accent" style="margin: 20px 0;">
          <div class="section-label" style="color: #1817fe;">Reply from Gainday support</div>
          <div><%= replyMessage %></div>
        </div>

        <!-- Quoted Original Message -->
        <% if (typeof originalMessage !== 'undefined' && originalMessage) { %>
        <div style="margin: 24px 0;">
          <div class="section-label" style="color: #767592;">Your original message</div>
          <div class="message-box" style="color: #494866; font-size: 13px;"><%= originalMessage %></div>
        </div>
        <% } %>

        <div class="divider"></div>

        <p style="font-size: 13px; color: #767592;">
          If you need more help, reply to this email or visit <a href="<%= appUrl %>/support" style="color: #1817fe; text-decoration: underline;">Gainday support</a>.
        </p>
      </div>

      <%- include('partials/_footer', { year: year, appUrl: appUrl }) %>
    </div>
  </div>
</body>
</html>
