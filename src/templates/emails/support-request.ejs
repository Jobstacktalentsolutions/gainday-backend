<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Support Request</title>
  <%- include('partials/_styles') %>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <%- include('partials/_header', { bannerTitle: 'Support & Appeal Request' }) %>

      <div class="content">
        <p class="intro">
          A new support inquiry / appeal has been submitted through Gainday.
        </p>

        <div class="details-box" style="margin-top: 20px;">
          <div class="detail-row">
            <span class="detail-label">Name</span>
            <span class="detail-value"><%= name %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Email</span>
            <span class="detail-value"><a href="mailto:<%= userEmail %>" style="color: #1817fe; text-decoration: underline;"><%= userEmail %></a></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Topic</span>
            <span class="detail-value"><%= topic %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Message ID</span>
            <span class="detail-value mono" style="color: #767592; font-size: 12px;"><%= messageId %></span>
          </div>
        </div>

        <div style="margin: 20px 0;">
          <div class="section-label">User message</div>
          <div class="message-box accent"><%= message %></div>
        </div>

        <div class="divider"></div>

        <p style="font-size: 13px; color: #767592;">
          You can reply directly to the user by clicking their email address above.
        </p>
      </div>

      <%- include('partials/_footer', { year: year, appUrl: appUrl }) %>
    </div>
  </div>
</body>
</html>
