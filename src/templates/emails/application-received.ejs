<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Application received</title>
  <%- include('partials/_styles') %>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <%- include('partials/_header', { bannerTitle: 'Application received' }) %>

      <div class="content">
        <p class="intro">
          Hi <%= typeof candidateName !== 'undefined' && candidateName ? candidateName : 'there' %>,<br><br>
          Thanks for applying for <strong><%= typeof jobTitle !== 'undefined' ? jobTitle : 'the role' %></strong><% if (typeof companyName !== 'undefined' && companyName) { %> at <strong><%= companyName %></strong><% } %>. We've received your application.
        </p>

        <div style="margin: 20px 0; font-size: 14px; color: #3a3a4d;">
          <div style="margin-bottom: 6px;"><strong>Role:</strong> <%= typeof jobTitle !== 'undefined' ? jobTitle : 'Role' %></div>
          <% if (typeof companyName !== 'undefined' && companyName) { %>
            <div style="margin-bottom: 6px;"><strong>Company:</strong> <%= companyName %></div>
          <% } %>
          <div style="margin-bottom: 6px;"><strong>Applied on:</strong> <%= typeof appliedDate !== 'undefined' ? appliedDate : new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></div>
        </div>

        <div class="cta-wrap">
          <a href="<%= typeof trackUrl !== 'undefined' && trackUrl ? trackUrl : (appUrl + '/job-board') %>" class="cta-button" target="_blank" style="background-color:#1817fe; color:#ffffff !important; text-decoration:none; padding:14px 32px; border-radius:10px; font-weight:600; font-size:15px; display:inline-block;">
            Track your application
          </a>
        </div>
      </div>

      <%- include('partials/_footer', { year: year, appUrl: appUrl }) %>
    </div>
  </div>
</body>
</html>
