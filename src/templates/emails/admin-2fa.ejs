<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Gainday admin verification code</title>
  <%- include('partials/_styles') %>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <%- include('partials/_header', { bannerTitle: 'Your verification code' }) %>

      <div class="content">
        <p class="intro">
          Use this code to sign in to your Gainday admin account.
        </p>

        <!-- 6-digit 2FA Code Card -->
        <div class="stat-card" style="background-color: #eef0fb; border: 1px solid #dcdcfb; padding: 28px; border-radius: 12px; text-align: center; margin: 24px 0;">
          <div style="font-size: 11px; font-weight: 700; color: #1817fe; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 8px;">
            Verification code
          </div>
          <div style="font-size: 38px; font-weight: 700; letter-spacing: 6px; color: #1817fe; font-family: monospace; line-height: 1.2;">
            <%= otp %>
          </div>
        </div>

        <div class="alert" style="margin-top: 20px;">
          <div class="alert-text">
            Do not share this code with anyone. Gainday staff will never ask for your verification code.
          </div>
        </div>

        <div class="divider"></div>

        <p class="intro" style="font-size: 13px; color: #6a6a85;">
          If you did not try to sign in, change your admin password and review your account security.
        </p>
      </div>

      <%- include('partials/_footer', { year: year, appUrl: appUrl }) %>
    </div>
  </div>
</body>
</html>
